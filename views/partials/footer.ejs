    <% if (typeof hasPulse !== 'undefined' && hasPulse) { %>
      <%- include('./pulse-sidebar') %>
    <% } %>
  </div><!-- /.app-shell -->

  <% if (typeof user !== 'undefined' && user) { %>
    <%- include('./bottom-nav', { activePage: typeof activePage !== 'undefined' ? activePage : '', unreadCount: typeof unreadCount !== 'undefined' ? unreadCount : 0 }) %>
  <% } %>

  <footer>
    <p>&copy; <%= new Date().getFullYear() %> Secrets — Made by Avaneesh</p>
  </footer>

  <div id="snackbar" class="snackbar" role="status" aria-live="polite"></div>

  <script src="/js/theme.js"></script>
  <script src="/js/app.js"></script>
</body>
</html>
