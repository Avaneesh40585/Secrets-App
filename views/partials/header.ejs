<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="color-scheme" content="light dark">
  <meta name="theme-color" content="#1A73E8" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#8AB4F8" media="(prefers-color-scheme: dark)">
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle + ' • Secrets' : 'Secrets' %></title>
  <link rel="icon" type="image/png" href="/assets/icons/favicon.png" />

  <!-- Prevent FOUC: apply theme before rendering -->
  <script>
    (function() {
      try {
        var stored = localStorage.getItem('secrets-theme');
        var theme = stored || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
      } catch (e) { document.documentElement.setAttribute('data-theme', 'light'); }
    })();
  </script>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Google+Sans:wght@300;400;500;600;700&family=Google+Sans+Display:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="/css/styles.css">

  <!-- Material Web Components (Google's official MD3 library) -->
  <script type="importmap">
    {
      "imports": {
        "@material/web/": "https://esm.run/@material/web/"
      }
    }
  </script>
  <script type="module">
    import '@material/web/all.js';
    import { styles as typescaleStyles } from '@material/web/typography/md-typescale-styles.js';
    if (typescaleStyles && typescaleStyles.styleSheet) {
      document.adoptedStyleSheets = [...document.adoptedStyleSheets, typescaleStyles.styleSheet];
    }
  </script>
</head>
<body<%= typeof user !== 'undefined' && user ? ' class="has-nav"' : '' %>>
  <header class="top-app-bar">
    <a href="<%= typeof user !== 'undefined' && user ? '/feed' : '/' %>" class="nav-brand">
      <img class="brand-icon" src="/assets/icons/favicon.png" alt="Secrets" width="32" height="32">
      <h1>Secrets</h1>
    </a>

    <% if (typeof user !== 'undefined' && user) { %>
      <form action="/search" method="GET" class="top-search-form" role="search">
        <span class="material-symbols-rounded top-search-icon">search</span>
        <input type="search" name="q" placeholder="Search secrets, people, tags…"
               class="top-search-input" autocomplete="off"
               value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>">
      </form>
    <% } %>

    <div class="nav-actions">
      <% if (typeof hasPulse !== 'undefined' && hasPulse) { %>
        <md-icon-button class="pulse-toggle-btn pulse-mobile-only" aria-label="Open Pulse panel">
          <span class="material-symbols-rounded">auto_awesome</span>
        </md-icon-button>
      <% } %>

      <md-icon-button class="theme-toggle" aria-label="Toggle theme">
        <span class="material-symbols-rounded">dark_mode</span>
      </md-icon-button>

      <% if (typeof user !== 'undefined' && user) { %>
        <md-text-button href="/logout">
          Sign out
          <span class="material-symbols-rounded" slot="icon">logout</span>
        </md-text-button>
      <% } else { %>
        <md-icon-button href="https://github.com/Avaneesh40585/Secrets-App/" target="_blank" aria-label="GitHub source">
          <span class="material-symbols-rounded">code</span>
        </md-icon-button>
      <% } %>
    </div>
  </header>

  <div class="app-shell<%= typeof hasPulse !== 'undefined' && hasPulse ? ' has-pulse' : '' %>">
    <% if (typeof user !== 'undefined' && user) { %>
      <%- include('./nav', { activePage: typeof activePage !== 'undefined' ? activePage : '', unreadCount: typeof unreadCount !== 'undefined' ? unreadCount : 0 }) %>
    <% } %>
